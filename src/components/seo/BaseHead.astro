---
/**
 * Document head: metadata, icons, fonts, social cards and structured data.
 *
 * The inline theme script runs before first paint so a visitor who chose a
 * theme never sees a flash of the other one.
 */
import { Font, getImage } from 'astro:assets';
import portrait from '../../assets/images/portrait.jpg';
import { siteConfig } from '../../config/site';
import { experience, profile } from '../../data/profile';

interface Props {
  /** Page title. Defaults to the site title. */
  title?: string;
  /** Meta description. Defaults to the site description. */
  description?: string;
  /** Set to true for pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
}

const { title = siteConfig.title, description = siteConfig.description, noindex = false } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Square social preview cropped from the portrait (works for Open Graph and X).
const socialImage = await getImage({
  src: portrait,
  width: 600,
  height: 600,
  fit: 'cover',
  position: 'top',
  format: 'jpg',
});
const socialImageUrl = new URL(socialImage.src, Astro.site);

const currentCompany = experience[0];

/** schema.org Person profile so search engines can build a knowledge panel. */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  jobTitle: profile.role,
  url: Astro.site?.toString(),
  image: socialImageUrl.toString(),
  email: `mailto:${profile.email}`,
  worksFor: { '@type': 'Organization', name: currentCompany.name },
  address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Escuela Colombiana de Ingeniería Julio Garavito' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad Internacional de Valencia' },
  ],
  knowsLanguage: ['es', 'en'],
  sameAs: [profile.social.linkedin.href, profile.social.github.href],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.fullName} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex" />}

<!-- Theme -->
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content={siteConfig.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={siteConfig.themeColor.dark} media="(prefers-color-scheme: dark)" />
<script is:inline>
  // Apply the saved theme before paint and flag that JavaScript is available.
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    try {
      var saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
    } catch (_) {
      /* Storage can be blocked; fall back to the OS preference. */
    }
  })();
</script>

<!-- Icons and app metadata -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="application-name" content={siteConfig.name} />
<meta name="apple-mobile-web-app-title" content={siteConfig.name} />

<!-- Fonts (self-hosted by the Astro Fonts API) -->
<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />

<!-- Open Graph / social cards -->
<meta property="og:type" content="profile" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:width" content="600" />
<meta property="og:image:height" content="600" />
<meta property="og:image:alt" content={`Portrait of ${profile.name}`} />
<meta property="profile:first_name" content="Luis Alejandro" />
<meta property="profile:last_name" content="Jaramillo Rincon" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
