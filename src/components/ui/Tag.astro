---
/**
 * Small pill used for skills and keywords. Purely presentational.
 */
---

<span class="tag"><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.8125rem;
    line-height: 1.3;
    white-space: nowrap;
  }
</style>
