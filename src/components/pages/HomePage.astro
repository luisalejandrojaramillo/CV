---
/**
 * Home page body, shared by every locale (`src/pages/index.astro`,
 * `src/pages/es/index.astro`). Sections read their copy from the locale of
 * the current URL, so this file holds no text.
 *
 * Section order follows how recruiters read a profile: who and what (hero),
 * key facts (highlights), fit (expertise), track record (experience),
 * credentials (education), depth (skills) and the next step (contact).
 */
import Contact from '../sections/Contact.astro';
import Education from '../sections/Education.astro';
import Experience from '../sections/Experience.astro';
import Expertise from '../sections/Expertise.astro';
import Hero from '../sections/Hero.astro';
import Highlights from '../sections/Highlights.astro';
import Skills from '../sections/Skills.astro';
import ResumeDialog from '../ui/ResumeDialog.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Hero />
  <Highlights />
  <Expertise />
  <Experience />
  <Education />
  <Skills />
  <Contact />
  <ResumeDialog />
</BaseLayout>
