---
/**
 * Education and certifications. The most recent degree (the Master's in AI)
 * is featured in a large panel; the remaining degrees and certificates are
 * listed in a compact column beside it.
 */
import type { Credential } from '../../data/profile';
import { getContent } from '../../i18n';

const { certifications, education, sections } = getContent(Astro.currentLocale);

const [featured, ...otherDegrees] = education;

/** Joins the optional period and location into one metadata line. */
const meta = (item: Credential) => [item.period, item.location].filter(Boolean).join(' · ');
---

<section id="education" class="section" aria-labelledby="education-title">
  <div class="container">
    <h2 id="education-title" class="section-title" data-reveal>{sections.education}</h2>

    <div class="credentials">
      {
        featured && (
          <article class="featured" data-reveal aria-labelledby="featured-degree">
            <p class="credential__meta">{meta(featured)}</p>
            <h3 id="featured-degree" class="featured__title">
              {featured.title}
            </h3>
            <p class="featured__issuer">{featured.issuer}</p>
            {featured.description && <p class="featured__description">{featured.description}</p>}
          </article>
        )
      }

      <div class="credentials__aside" data-reveal style="--reveal-index: 1">
        {
          otherDegrees.length > 0 && (
            <div>
              <h3 class="credentials__heading">{sections.degree}</h3>
              <ul role="list" class="credentials__list">
                {otherDegrees.map((item) => (
                  <li>
                    <p class="credential__title">{item.title}</p>
                    <p class="credential__issuer">{item.issuer}</p>
                    <p class="credential__meta">{meta(item)}</p>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div>
          <h3 class="credentials__heading">{sections.certifications}</h3>
          <ul role="list" class="credentials__list">
            {
              certifications.map((item) => (
                <li>
                  <p class="credential__title">{item.title}</p>
                  <p class="credential__issuer">{item.issuer}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .credentials {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .featured {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    min-height: 22rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-surface);
    background:
      radial-gradient(110% 90% at 100% 0%, color-mix(in srgb, var(--color-accent) 18%, transparent), transparent 60%),
      var(--color-accent-soft);
  }

  .featured__title {
    max-width: 16ch;
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
    letter-spacing: -0.035em;
  }

  .featured__issuer {
    color: var(--color-text);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .featured__description {
    max-width: 48ch;
    margin-top: 0.5rem;
    color: var(--color-text);
    opacity: 0.85;
  }

  .featured .credential__meta {
    margin-bottom: auto;
    padding-bottom: 2rem;
    color: var(--color-accent-text);
  }

  .credentials__aside {
    display: grid;
    align-content: start;
    gap: 2.5rem;
  }

  .credentials__heading {
    color: var(--color-text-muted);
    font-family: var(--font-mono-stack);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .credentials__list {
    display: grid;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .credential__title {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .credential__issuer {
    margin-top: 0.125rem;
    color: var(--color-text-muted);
  }

  .credential__meta {
    margin-top: 0.375rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono-stack);
    font-size: 0.8125rem;
  }

  @media (max-width: 899px) {
    .credentials {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured {
      min-height: 0;
    }
  }
</style>
