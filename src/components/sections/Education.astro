---
/**
 * Education and certifications side by side: degrees on the left with their
 * periods, certificates on the right as a compact list.
 */
import { certifications, education } from '../../data/profile';
---

<section id="education" class="section" aria-labelledby="education-title">
  <div class="container">
    <h2 id="education-title" class="section-title" data-reveal>Education and certifications</h2>

    <div class="credentials">
      <div data-reveal>
        <h3 class="credentials__heading">Education</h3>
        <ul role="list" class="credentials__list">
          {
            education.map((item) => (
              <li class="credential credential--degree">
                <p class="credential__title">{item.title}</p>
                <p class="credential__issuer">{item.issuer}</p>
                {item.detail && <p class="credential__detail">{item.detail}</p>}
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal style="--reveal-index: 1">
        <h3 class="credentials__heading">Certifications</h3>
        <ul role="list" class="credentials__list">
          {
            certifications.map((item) => (
              <li class="credential">
                <p class="credential__title">{item.title}</p>
                <p class="credential__issuer">{item.issuer}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .credentials {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .credentials__heading {
    color: var(--color-text-muted);
    font-family: var(--font-mono-stack);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .credentials__list {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .credential__title {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .credential--degree .credential__title {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .credential__issuer {
    margin-top: 0.25rem;
    color: var(--color-text-muted);
  }

  .credential__detail {
    margin-top: 0.375rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono-stack);
    font-size: 0.8125rem;
  }

  @media (max-width: 767px) {
    .credentials {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
