---
/**
 * Expertise: the three things this person brings to a team, as an
 * asymmetric bento (one tall lead tile, two stacked tiles). Each tile has
 * its own surface treatment so the grid has rhythm, not repetition.
 */
import { focusAreas } from '../../data/profile';
import Tag from '../ui/Tag.astro';

const variants = ['lead', 'outline', 'pattern'] as const;
---

<section id="expertise" class="section" aria-labelledby="expertise-title">
  <div class="container">
    <h2 id="expertise-title" class="section-title" data-reveal>What I bring to a team</h2>

    <ul role="list" class="bento">
      {
        focusAreas.map((area, index) => (
          <li
            class:list={['bento__tile', `bento__tile--${variants[index % variants.length]}`]}
            data-reveal
            style={`--reveal-index: ${index}`}
          >
            {area.status && <p class="bento__status">{area.status}</p>}
            <h3 class="bento__title">{area.title}</h3>
            <p class="bento__description">{area.description}</p>
            <ul role="list" class="bento__tags">
              {area.tags.map((tag) => (
                <li>
                  <Tag>{tag}</Tag>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto auto;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .bento__tile {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-surface);
  }

  .bento__title {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .bento__description {
    max-width: 46ch;
    color: var(--color-text-muted);
  }

  .bento__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  /* Lead tile: spans both rows, accent-tinted, larger type. */
  .bento__tile--lead {
    grid-row: span 2;
    justify-content: flex-end;
    min-height: 24rem;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 60%),
      var(--color-accent-soft);
  }

  .bento__status {
    max-width: 26ch;
    margin-bottom: auto;
    padding-bottom: 2rem;
    color: var(--color-accent-text);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .bento__tile--lead .bento__title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }

  .bento__tile--lead .bento__description {
    font-size: 1.0625rem;
    color: var(--color-text);
    opacity: 0.85;
  }

  .bento__tile--lead .bento__tags {
    margin-top: 0.5rem;
  }

  .bento__tile--outline {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  /* Dot grid hints at circuitry for the AI tile without an illustration. */
  .bento__tile--pattern {
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--color-text) 14%, transparent) 1px, transparent 0) 0 0 /
        14px 14px,
      var(--color-surface-muted);
  }

  @media (max-width: 899px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }

    .bento__tile--lead {
      grid-row: auto;
      min-height: 0;
    }
  }
</style>
