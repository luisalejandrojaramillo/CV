---
/**
 * "At a glance" strip: four short facts about what the person offers today.
 * Four columns on desktop, a 2x2 grid on small screens.
 */
import { getContent } from '../../i18n';

const { highlights, sections } = getContent(Astro.currentLocale);
---

<section class="highlights" aria-labelledby="highlights-title">
  <div class="container">
    <h2 id="highlights-title" class="visually-hidden">{sections.highlights}</h2>
    <dl class="highlights__grid">
      {
        highlights.map((highlight, index) => (
          <div class="highlights__item" data-reveal style={`--reveal-index: ${index}`}>
            <dt class="highlights__value">{highlight.value}</dt>
            <dd class="highlights__description">{highlight.description}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .highlights__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--color-border);
  }

  .highlights__item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem 1.5rem 2.25rem;
  }

  .highlights__item + .highlights__item {
    border-left: 1px solid var(--color-border);
  }

  .highlights__item:first-child {
    padding-left: 0;
  }

  .highlights__value {
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    white-space: nowrap;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .highlights__description {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: 24ch;
  }

  @media (max-width: 899px) {
    .highlights__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .highlights__item {
      padding: 1.75rem 1.25rem;
    }

    .highlights__item:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .highlights__item:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
  }
</style>
