---
/**
 * Impact strip: real, résumé-backed numbers recruiters can quote.
 * Four columns on desktop, a 2x2 grid on small screens.
 */
import { getContent } from '../../i18n';

const { metrics, sections } = getContent(Astro.currentLocale);
---

<section class="impact" aria-labelledby="impact-title">
  <div class="container">
    <h2 id="impact-title" class="visually-hidden">{sections.impact}</h2>
    <dl class="impact__grid">
      {
        metrics.map((metric, index) => (
          <div class="impact__item" data-reveal style={`--reveal-index: ${index}`}>
            <dt class="impact__value">{metric.value}</dt>
            <dd class="impact__description">{metric.description}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .impact__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--color-border);
  }

  .impact__item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem 1.5rem 2.25rem;
  }

  .impact__item + .impact__item {
    border-left: 1px solid var(--color-border);
  }

  .impact__item:first-child {
    padding-left: 0;
  }

  .impact__value {
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .impact__description {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
    max-width: 24ch;
  }

  @media (max-width: 899px) {
    .impact__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .impact__item {
      padding: 1.75rem 1.25rem;
    }

    .impact__item:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .impact__item:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
  }
</style>
