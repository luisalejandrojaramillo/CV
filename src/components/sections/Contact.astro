---
/**
 * Closing call to action. Email is the primary channel (with a copy button
 * for visitors without a mail client); LinkedIn and GitHub are secondary.
 */
import ArrowUpRightIcon from '@phosphor-icons/core/regular/arrow-up-right.svg';
import CopyIcon from '@phosphor-icons/core/regular/copy.svg';
import EnvelopeIcon from '@phosphor-icons/core/regular/envelope-simple.svg';
import GithubIcon from '@phosphor-icons/core/regular/github-logo.svg';
import LinkedinIcon from '@phosphor-icons/core/regular/linkedin-logo.svg';
import { profile } from '../../data/profile';
import Button from '../ui/Button.astro';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__panel" data-reveal>
      <h2 id="contact-title" class="contact__title">Building a payments team? Let’s talk.</h2>
      <p class="contact__lead">
        I’m open to conversations about Tech Lead and engineering leadership roles. Based in {profile.location}, working
        in Spanish and English.
      </p>

      <div class="contact__actions">
        <Button href={`mailto:${profile.email}`}>
          Send an email
          <EnvelopeIcon slot="icon" aria-hidden="true" />
        </Button>
        <button class="contact__copy" type="button" data-copy-email={profile.email}>
          <CopyIcon aria-hidden="true" />
          <span data-copy-label>{profile.email}</span>
        </button>
        <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
      </div>

      <ul role="list" class="contact__links">
        <li>
          <a href={profile.social.linkedin.href} target="_blank" rel="noopener noreferrer">
            <LinkedinIcon aria-hidden="true" />
            {profile.social.linkedin.label}
            <ArrowUpRightIcon class="contact__external" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a href={profile.social.github.href} target="_blank" rel="noopener noreferrer">
            <GithubIcon aria-hidden="true" />
            {profile.social.github.label}
            <ArrowUpRightIcon class="contact__external" aria-hidden="true" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  import { initCopyEmail } from '../../scripts/copy-email';

  initCopyEmail();
</script>

<style>
  .contact__panel {
    padding: clamp(2rem, 6vw, 4.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-surface);
    background:
      radial-gradient(80% 120% at 0% 100%, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 65%),
      var(--color-surface);
  }

  .contact__title {
    max-width: 18ch;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    letter-spacing: -0.04em;
  }

  .contact__lead {
    margin-top: 1.25rem;
    max-width: 52ch;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .contact__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-mono-stack);
    font-size: 0.875rem;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s var(--ease-out);
  }

  .contact__copy:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
  }

  .contact__copy:active {
    transform: scale(0.98);
  }

  .contact__copy[data-state='copied'] {
    border-style: solid;
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  .contact__copy :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .contact__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .contact__links a:hover {
    color: var(--color-accent-text);
  }

  .contact__links :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .contact__links :global(.contact__external) {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 479px) {
    .contact__panel {
      padding: 2rem 1.25rem;
    }

    .contact__copy {
      max-width: 100%;
      font-size: 0.75rem;
    }

    .contact__copy span {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
