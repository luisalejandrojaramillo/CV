---
/**
 * Home page. Section order follows how recruiters read a profile:
 * who and what (hero), proof (impact), fit (expertise), track record
 * (experience), depth (skills, education) and the next step (contact).
 */
import Contact from '../components/sections/Contact.astro';
import Education from '../components/sections/Education.astro';
import Experience from '../components/sections/Experience.astro';
import Expertise from '../components/sections/Expertise.astro';
import Hero from '../components/sections/Hero.astro';
import Impact from '../components/sections/Impact.astro';
import Skills from '../components/sections/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Hero />
  <Impact />
  <Expertise />
  <Experience />
  <Skills />
  <Education />
  <Contact />
</BaseLayout>
