---
/**
 * Home page. Section order follows how recruiters read a profile:
 * who and what (hero), key facts (highlights), fit (expertise), track
 * record (experience), credentials (education), depth (skills) and the
 * next step (contact).
 */
import Contact from '../components/sections/Contact.astro';
import Education from '../components/sections/Education.astro';
import Experience from '../components/sections/Experience.astro';
import Expertise from '../components/sections/Expertise.astro';
import Hero from '../components/sections/Hero.astro';
import Highlights from '../components/sections/Highlights.astro';
import Skills from '../components/sections/Skills.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Hero />
  <Highlights />
  <Expertise />
  <Experience />
  <Education />
  <Skills />
  <Contact />
</BaseLayout>
